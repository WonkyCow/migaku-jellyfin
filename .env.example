# Copy to .env and edit. .env is git-ignored; never commit it.

# Comma-separated Jellyfin hostnames/IPs the patched Migaku should treat as video sites (no ports, no scheme).
JELLYFIN_HOSTS=jellyfin.example.com,192.168.1.10

# Pristine copy of the installed Migaku extension version folder (patch.py never touches the installed one).
MIGAKU_SRC=~/migaku-src/1.32.0.0_0

# Where the patched, unpacked extension is written.
MIGAKU_OUT=build/migaku-jellyfin

# Only used by jellyfin-patch/run-dev.sh
BRAVE_BIN=/opt/brave.com/brave/brave
DEV_PROFILE_DIR=~/.config/brave-migaku-dev
JELLYFIN_URL=http://192.168.1.10:8096/web/
